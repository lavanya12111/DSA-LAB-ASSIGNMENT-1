#include <iostream>
using namespace std;

void leftRotate(int arr[], int n, int k) {
    k = k % n;

    int temp[100];

    for (int i = 0; i < n; i++) {
        temp[i] = arr[(i + k) % n];
    }

    for (int i = 0; i < n; i++) {
        arr[i] = temp[i];
    }
}

void rightRotate(int arr[], int n, int k) {
    k = k % n;

    int temp[100];

    for (int i = 0; i < n; i++) {
        temp[(i + k) % n] = arr[i];
    }

    for (int i = 0; i < n; i++) {
        arr[i] = temp[i];
    }
}

int main() {
    int arr[100];
    int n, k;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements:\n";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "Enter K: ";
    cin >> k;

    // Left rotation
    leftRotate(arr, n, k);

    cout << "Left rotation: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    // Restore original array by rotating right
    rightRotate(arr, n, k);

    // Right rotation
    rightRotate(arr, n, k);

    cout << "\nRight rotation: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
